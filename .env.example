# Copy this file to .env and fill in real values. .env is gitignored - never commit real credentials.

# Base URL of the environment under test
PP_BASE_URL=https://testbox-payment-panel.ejara.tech/

# Test account
PP_USERNAME=
PP_PASSWORD=

# OTP: on testbox any 6 digits are accepted. In production a fixed/random value MUST fail -
# this asymmetry is itself a test case (see docs/inferred-spec.md, Authentication module).
PP_OTP=123456

# Which environment this run targets: testbox | staging | production
PP_ENV=testbox
